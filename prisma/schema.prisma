// Prisma schema voor het CMS — multi-site versie
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Platformbreed: SUPERADMIN ziet/beheert alle sites, USER moet per site worden toegevoegd
enum Role {
  SUPERADMIN
  USER
}

// Rol van een gebruiker BINNEN één specifieke site
enum SiteRole {
  ADMIN
  EDITOR
  AUTHOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum TemplateType {
  HEADER
  FOOTER
  PAGE
  POST
  ARCHIVE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  siteMemberships SiteUser[]
  posts           Post[]
  media           Media[]

  @@map("users")
}

model Site {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique // bv. "site-a.nl" — bepaalt welke site een bezoeker te zien krijgt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    SiteUser[]
  themes     Theme[]
  pages      Page[]
  posts      Post[]
  categories Category[]
  tags       Tag[]
  media      Media[]
  menus      Menu[]
  settings   Setting[]

  @@map("sites")
}

model SiteUser {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      SiteRole @default(AUTHOR)
  createdAt DateTime @default(now())

  @@unique([siteId, userId])
  @@map("site_users")
}

model Theme {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  isActive  Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates ThemeTemplate[]
  pages     Page[]

  @@unique([siteId, slug])
  @@map("themes")
}

model ThemeTemplate {
  id        String       @id @default(cuid())
  themeId   String
  theme     Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)
  type      TemplateType
  name      String
  html      String       @default("")
  css       String       @default("")
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  pages Page[]

  @@map("theme_templates")
}

model Page {
  id             String         @id @default(cuid())
  siteId         String
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  themeId        String?
  theme          Theme?         @relation(fields: [themeId], references: [id])
  templateId     String?
  template       ThemeTemplate? @relation(fields: [templateId], references: [id])
  title          String
  slug           String
  content        Json           @default("{}")
  status         ContentStatus  @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  menuItems MenuItem[]

  @@unique([siteId, slug])
  @@map("pages")
}

model Post {
  id          String        @id @default(cuid())
  siteId      String
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  title       String
  slug        String
  content     Json          @default("{}")
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tags PostTag[]

  @@unique([siteId, slug])
  @@map("posts")
}

model Category {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String
  slug   String

  posts Post[]

  @@unique([siteId, slug])
  @@map("categories")
}

model Tag {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String
  slug   String

  posts PostTag[]

  @@unique([siteId, slug])
  @@map("tags")
}

model PostTag {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Media {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  filename     String
  path         String
  mimeType     String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@map("media")
}

model Menu {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id        String  @id @default(cuid())
  menuId    String
  menu      Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label     String
  url       String? // los adres, bv. "https://externe-link.nl" — wordt genegeerd als pageId is gezet
  pageId    String?
  page      Page?   @relation(fields: [pageId], references: [id])
  sortOrder Int     @default(0)

  @@map("menu_items")
}

model Setting {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key    String
  value  Json

  @@unique([siteId, key])
  @@map("settings")
}
